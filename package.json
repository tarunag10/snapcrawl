{
  "name": "snapcrawl",
  "version": "0.1.0",
  "description": "Plug-and-play toolkit to auto-record MP4 demo videos and multi-viewport screenshots of any website",
  "main": "dist/snapcrawl.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarunag10/snapcrawl.git"
  },
  "homepage": "https://github.com/tarunag10/snapcrawl#readme",
  "bugs": {
    "url": "https://github.com/tarunag10/snapcrawl/issues"
  },
  "exports": {
    ".": "./dist/snapcrawl.js",
    "./mcp": "./dist/mcp-server.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "snapcrawl": "dist/snapcrawl.js",
    "snapcrawl-record": "dist/record-workflow.js",
    "snapcrawl-init": "dist/create-snapcrawl.js",
    "snapcrawl-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist/",
    "templates/",
    "index.d.ts",
    "README.md",
    "CAPTURE_CONFIG_GUIDE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "node --test tests/*.test.js",
    "audit:prod": "npm audit --omit=dev",
    "prepublishOnly": "npm run build",
    "workflow:record": "node scripts/record-workflow.js --config workflow-recorder.config.json",
    "workflow:record:headful": "node scripts/record-workflow.js --config workflow-recorder.config.json --headful",
    "capture:screenshots": "node scripts/capture-from-config.js --config capture-config.json",
    "workflow:install": "npx playwright install chromium"
  },
  "keywords": [
    "screenshot",
    "video",
    "recorder",
    "playwright",
    "crawl",
    "demo",
    "mp4"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ffmpeg-static": "^5.2.0",
    "playwright": "^1.53.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
